  "kind": "plugin",
  "id": "dsh-whale-diving",
  "name": "dsh-whale-diving",
  "description": "鲸鱼下潜动画：在对话流的运行中回合状态旁画一只下潜的小鲸鱼",
  "createdAt": 1790091363349,
  "files": [
    {
      "path": "cordis.patch.yml",
      "encoding": "utf8",
      "content": "# dsh-whale-diving bundle patch: one row.\n#\n# 安装到 profile 后，这一行让 Loader 加载本包的宿主半边（lib/index.js，空实现），\n# 而浏览器半边（lib/client.js）由 dsh-client-modules 依据 package.json 的\n# dsh.client 声明扫描进 window.__DSH_BOOT__。两者都靠本行的 name 与包名一致：\n# name 既是 Loader 解析的模块说明符，也是浏览器模块注册的 id。\n- insert:\n    - id: whale-diving\n      name: dsh-whale-diving\n"
    },
    {
      "path": "index.js",
      "encoding": "utf8",
      "content": "/**\n * dsh-whale-diving —— 宿主半边：一个空实现。\n *\n * 这个插件的全部能力都在浏览器半边（lib/client.js）：它把一只下潜的鲸鱼注册到\n * 对话流运行中回合状态的图标位 `conversation.chat.turnStatusIcon`（由\n * @deepseek-ai/dsh-client-ui-conversation 声明，无人注册时该位置渲染为空）。\n *\n * 宿主半边之所以存在，是因为 Loader 必须能 import 本行：cordis.patch.yml 插入的\n * 那一行 name 是 `dsh-whale-diving`，Loader 解析它拿到本文件；而浏览器花名册的扫描\n * 以「已启用的 loader 行名」为入口，用同一个包名读 package.json 的 dsh.client，\n * 找到并伺服 lib/client.js。两半共用一个包名，所以行名不能改。\n */\n\n/** Cordis 插件名。 */\nexport const name = 'whale-diving'\n\n/** 宿主侧无行为：这只鲸鱼只在浏览器里游。 */\nexport function apply() {}\n"
    },
    {
      "path": "lib/client.js",
      "encoding": "utf8",
      "content": "window.__ModuleLoader__.load({\n\tid: \"dsh-whale-diving\",\n\tfactory: (require) => {\n\t\tvar module = { exports: {} };\n\t\tvar exports = module.exports;\n\t\tObject.defineProperty(exports, Symbol.toStringTag, { value: \"Module\" });\n\t\tlet react_jsx_runtime = require(\"react/jsx-runtime\");\n\t\tlet _deepseek_ai_dsh_client_ui_primitives = require(\"@deepseek-ai/dsh-client-ui-primitives\");\n\t\t//#region \\0dsh-css:dsh-whale-diving/src/client/WhaleDivingLogo.module.css\n\t\tconst css = \".s_EGnG_root{width:22px;height:22px;color:var(--dsw-alias-state-business-primary);flex:none;margin-right:6px;position:relative}.s_EGnG_whale{will-change:transform, opacity;backface-visibility:hidden;z-index:2;animation:3.6s linear infinite s_EGnG_dsh-whale-path;display:flex;position:absolute;bottom:4px;left:3px}.s_EGnG_whale>svg{transform-box:fill-box;transform-origin:52% 72%;will-change:transform;animation:3.6s linear infinite s_EGnG_dsh-whale-pose}.s_EGnG_fx{pointer-events:none;z-index:3;width:22px;height:22px;position:absolute;inset:0}.s_EGnG_surface,.s_EGnG_ripple,.s_EGnG_spray,.s_EGnG_splash{fill:none;stroke:currentColor;stroke-linecap:round}.s_EGnG_surface{stroke-width:1.1px;opacity:.28}.s_EGnG_ripple,.s_EGnG_spray,.s_EGnG_splash{stroke-dasharray:1;stroke-dashoffset:1px}.s_EGnG_ripple{stroke-width:.9px;transform-box:fill-box;transform-origin:50%;animation:3.6s linear infinite s_EGnG_dsh-whale-ripple}.s_EGnG_spray{stroke-width:1.05px;animation:3.6s linear infinite s_EGnG_dsh-whale-spray}.s_EGnG_splash{stroke-width:1px;animation:3.6s linear infinite s_EGnG_dsh-whale-splash}@keyframes s_EGnG_dsh-whale-path{0%,8%{opacity:0;transform:translateY(8px)}16%{opacity:.45;transform:translate(-.5px,4px)}24%{opacity:1;transform:translate(-1px)}32%{opacity:1;transform:translate(-.5px,-2px)}40%{opacity:1;transform:translateY(-3px)}48%{opacity:1;transform:translate(.5px,-2px)}56%{opacity:1;transform:translate(1px)}64%{opacity:.9;transform:translate(.5px,3px)}72%{opacity:0;transform:translate(-.5px,8px)}to{opacity:0;transform:translateY(8px)}}@keyframes s_EGnG_dsh-whale-pose{0%,16%{transform:rotate(0)}32%{transform:rotate(9deg)}40%{transform:rotate(8deg)}48%{transform:rotate(3deg)}56%{transform:rotate(-5deg)}64%{transform:rotate(-18deg)}72%{transform:rotate(-25deg)}80%,to{transform:rotate(0)}}@keyframes s_EGnG_dsh-whale-spray{0%,24%{stroke-dashoffset:1px;opacity:0}31%{stroke-dashoffset:0;opacity:.85}40%{stroke-dashoffset:0;opacity:.7}48%{stroke-dashoffset:-1px;opacity:0}to{stroke-dashoffset:1px;opacity:0}}@keyframes s_EGnG_dsh-whale-splash{0%,57%{stroke-dashoffset:1px;opacity:0}64%{stroke-dashoffset:0;opacity:.75}72%{stroke-dashoffset:-1px;opacity:0}to{stroke-dashoffset:1px;opacity:0}}@keyframes s_EGnG_dsh-whale-ripple{0%,59%{stroke-dashoffset:1px;opacity:0;transform:scaleX(.2)}65%{stroke-dashoffset:0;opacity:.6;transform:scaleX(.38)}75%{stroke-dashoffset:0;opacity:.45;transform:scaleX(.72)}88%{stroke-dashoffset:0;opacity:0;transform:scaleX(1)}to{stroke-dashoffset:1px;opacity:0;transform:scaleX(1)}}@media (prefers-reduced-motion:reduce){.s_EGnG_whale,.s_EGnG_whale>svg,.s_EGnG_ripple{animation:none}.s_EGnG_whale{opacity:1;transform:translateY(-1px)}.s_EGnG_ripple{stroke-dashoffset:0;opacity:.55;transform:scaleX(.72)}.s_EGnG_spray,.s_EGnG_splash{display:none}}\";\n\t\tconst tagId = \"dsh-whale-diving/WhaleDivingLogo.module.css\";\n\t\tif (typeof document !== \"undefined\" && document.querySelector(\"style[data-plugin-css=\" + JSON.stringify(tagId) + \"]\") === null) {\n\t\t\tconst tag = document.createElement(\"style\");\n\t\t\ttag.dataset.plugin = \"dsh-whale-diving\";\n\t\t\ttag.dataset.pluginCss = tagId;\n\t\t\ttag.textContent = css;\n\t\t\tdocument.head.appendChild(tag);\n\t\t}\n\t\tvar WhaleDivingLogo_module_css_default = {\n\t\t\t\"dsh-whale-pose\": \"s_EGnG_dsh-whale-pose\",\n\t\t\t\"surface\": \"s_EGnG_surface\",\n\t\t\t\"dsh-whale-spray\": \"s_EGnG_dsh-whale-spray\",\n\t\t\t\"root\": \"s_EGnG_root\",\n\t\t\t\"splash\": \"s_EGnG_splash\",\n\t\t\t\"dsh-whale-ripple\": \"s_EGnG_dsh-whale-ripple\",\n\t\t\t\"ripple\": \"s_EGnG_ripple\",\n\t\t\t\"fx\": \"s_EGnG_fx\",\n\t\t\t\"spray\": \"s_EGnG_spray\",\n\t\t\t\"dsh-whale-splash\": \"s_EGnG_dsh-whale-splash\",\n\t\t\t\"dsh-whale-path\": \"s_EGnG_dsh-whale-path\",\n\t\t\t\"whale\": \"s_EGnG_whale\"\n\t\t};\n\t\t//#endregion\n\t\t//#region lib/types/client/WhaleDivingLogo.js\n\t\t/** Whale-diving turn-status icon: the DeepSeek whale breaching with a spout. */\n\t\t/**\n\t\t* Render a looping breach, spout, dive, and settling surface. Purely\n\t\t* decorative: the parent status row carries the accessible label.\n\t\t* @param _props - framework session kit (unused; the animation is self-contained).\n\t\t*/\n\t\tfunction WhaleDivingLogo(_props) {\n\t\t\treturn (0, react_jsx_runtime.jsxs)(\"span\", {\n\t\t\t\tclassName: WhaleDivingLogo_module_css_default.root,\n\t\t\t\t\"aria-hidden\": \"true\",\n\t\t\t\tchildren: [(0, react_jsx_runtime.jsxs)(\"svg\", {\n\t\t\t\t\tclassName: WhaleDivingLogo_module_css_default.fx,\n\t\t\t\t\tviewBox: \"0 0 22 22\",\n\t\t\t\t\tfill: \"none\",\n\t\t\t\t\t\"aria-hidden\": \"true\",\n\t\t\t\t\tchildren: [\n\t\t\t\t\t\t(0, react_jsx_runtime.jsx)(\"path\", {\n\t\t\t\t\t\t\tclassName: WhaleDivingLogo_module_css_default.surface,\n\t\t\t\t\t\t\td: \"M3 16.3 Q11 17.1 19 16.3\"\n\t\t\t\t\t\t}),\n\t\t\t\t\t\t(0, react_jsx_runtime.jsx)(\"path\", {\n\t\t\t\t\t\t\tclassName: WhaleDivingLogo_module_css_default.ripple,\n\t\t\t\t\t\t\tpathLength: \"1\",\n\t\t\t\t\t\t\td: \"M4 16.4 Q11 18.2 18 16.4\"\n\t\t\t\t\t\t}),\n\t\t\t\t\t\t(0, react_jsx_runtime.jsx)(\"path\", {\n\t\t\t\t\t\t\tclassName: WhaleDivingLogo_module_css_default.spray,\n\t\t\t\t\t\t\tpathLength: \"1\",\n\t\t\t\t\t\t\td: \"M9.8 5.2 C9.7 4.1 9.8 3.2 10.2 2.6\"\n\t\t\t\t\t\t}),\n\t\t\t\t\t\t(0, react_jsx_runtime.jsx)(\"path\", {\n\t\t\t\t\t\t\tclassName: WhaleDivingLogo_module_css_default.spray,\n\t\t\t\t\t\t\tpathLength: \"1\",\n\t\t\t\t\t\t\td: \"M10.2 2.6 C9.2 1.9 8.3 2 7.8 2.7\"\n\t\t\t\t\t\t}),\n\t\t\t\t\t\t(0, react_jsx_runtime.jsx)(\"path\", {\n\t\t\t\t\t\t\tclassName: WhaleDivingLogo_module_css_default.spray,\n\t\t\t\t\t\t\tpathLength: \"1\",\n\t\t\t\t\t\t\td: \"M10.2 2.6 C11.2 1.9 12.2 2 12.8 2.8\"\n\t\t\t\t\t\t}),\n\t\t\t\t\t\t(0, react_jsx_runtime.jsx)(\"path\", {\n\t\t\t\t\t\t\tclassName: WhaleDivingLogo_module_css_default.splash,\n\t\t\t\t\t\t\tpathLength: \"1\",\n\t\t\t\t\t\t\td: \"M10.7 16.2 C9.7 15 8.8 13.9 8.5 12.8\"\n\t\t\t\t\t\t}),\n\t\t\t\t\t\t(0, react_jsx_runtime.jsx)(\"path\", {\n\t\t\t\t\t\t\tclassName: WhaleDivingLogo_module_css_default.splash,\n\t\t\t\t\t\t\tpathLength: \"1\",\n\t\t\t\t\t\t\td: \"M11.2 16.2 C12.3 15 13.2 14.2 13.8 13.2\"\n\t\t\t\t\t\t})\n\t\t\t\t\t]\n\t\t\t\t}), (0, react_jsx_runtime.jsx)(\"span\", {\n\t\t\t\t\tclassName: WhaleDivingLogo_module_css_default.whale,\n\t\t\t\t\t\"data-whale-logo\": true,\n\t\t\t\t\tchildren: (0, react_jsx_runtime.jsx)(_deepseek_ai_dsh_client_ui_primitives.FishLogo, { size: 16 })\n\t\t\t\t})]\n\t\t\t});\n\t\t}\n\t\t//#endregion\n\t\t//#region lib/types/client/index.js\n\t\t/** Required services (cordis fiber inject). */\n\t\tconst inject = [\"slots\"];\n\t\t/**\n\t\t* Client plugin body: register the looping whale animation into the turn-status\n\t\t* icon seat declared by ui-conversation. The seat renders nothing when no\n\t\t* occupant registers, so this plugin is additive and self-contained.\n\t\t* @param ctx - client root context.\n\t\t*/\n\t\tfunction apply(ctx) {\n\t\t\tctx.slots.inject(\"conversation.chat.turnStatusIcon\", () => ctx.slots.register({ name: \"conversation.chat.turnStatusIcon\" }, WhaleDivingLogo));\n\t\t}\n\t\t//#endregion\n\t\texports.apply = apply;\n\t\texports.inject = inject;\n\t\treturn module.exports;\n\t}\n});\n\n"
    },
    {
      "path": "package.json",
      "encoding": "utf8",
      "content": "{\n  \"name\": \"dsh-whale-diving\",\n  \"version\": \"0.1.0\",\n  \"description\": \"鲸鱼下潜动画：在对话流的运行中回合状态旁画一只下潜的小鲸鱼\",\n  \"type\": \"module\",\n  \"main\": \"index.js\",\n  \"exports\": {\n    \".\": \"./index.js\",\n    \"./client\": {\n      \"default\": \"./lib/client.js\"\n    },\n    \"./package.json\": \"./package.json\"\n  },\n  \"dsh\": {\n    \"bundle\": {\n      \"patch\": \"./cordis.patch.yml\"\n    },\n    \"client\": {\n      \"platform\": \"web\",\n      \"inject\": [\n        \"@deepseek-ai/dsh-client-runtime\",\n        \"@deepseek-ai/dsh-client-ui-conversation\",\n        \"@deepseek-ai/dsh-client-ui-primitives\",\n        \"@deepseek-ai/dsh-client-ui-slots\"\n      ]\n    }\n  },\n  \"files\": [\n    \"index.js\",\n    \"lib/client.js\",\n    \"cordis.patch.yml\",\n    \"README.md\"\n  ],\n  \"keywords\": [\n    \"deepseek-harness\",\n    \"dsh\",\n    \"plugin\",\n    \"ui\",\n    \"whale\"\n  ],\n  \"license\": \"MIT\"\n}\n"
    },
    {
      "path": "README.md",
      "encoding": "utf8",
      "content": "# dsh-whale-diving\n\n一只下潜的鲸鱼：它出现在对话流「运行中」那条回合状态旁边，跟着回合一起呼吸。\n纯装饰，零业务面：不注册工具、不写提示词段落、不改任何请求内容。\n\n## 它挂在哪里\n\n`conversation.chat.turnStatusIcon`，由 `@deepseek-ai/dsh-client-ui-conversation`\n声明的单占位（single）槽位，会话作用域。没人注册时那个位置渲染为空，所以这个插件\n是纯增量的：装上就多一只鲸鱼，卸掉就恢复纯文字状态行。\n\n## 两半为什么长这样\n\n| 半边 | 文件 | 作用 |\n| ---- | ---- | ---- |\n| host | `index.js` | 空实现。存在的唯一理由是 `cordis.patch.yml` 插入的那一行必须能被 Loader import 成功 |\n| browser | `lib/client.js` | 预构建的经典脚本，自己调用 `window.__ModuleLoader__.load({ id, factory })` 注册 |\n\n两半共用同一个包名，而且这个包名 = patch 里那一行的 `name` = 浏览器模块注册的 `id`。\n改包名必须同时改这三处，否则浏览器半边会注册成孤儿模块。\n\n## 安装\n\n由 **chest** 管理：侧边栏 chest 的 plugin 分区里点 install，就是把本目录\n`link:` 进当前 profile 的依赖、把包名加进 `dsh.profile.bundles`、并在 profile 的\n`node_modules` 里建一个目录链接。三件事做完需要重启 `dsh web` 才生效——Loader 在启动时\n把 bundle 层组合好，浏览器花名册也只在启动时扫一次。\n\n## 修改与重新构建\n\n`src/` 是原始 TSX 源码，留在这里便于阅读和修改；`lib/client.js` 是构建产物。\n本目录不在 dsh 源码工作区里，所以没有随手的构建命令。要改动画：\n\n1. 把 `src/` 里的文件放回 dsh 源码树（`packages/client/<名字>/src/`），补一个使用\n   `clientBundle('<包名>', [...])` 的 `tsdown.config.ts`；\n2. 在源码树里跑 `npm run build:lib:client`；\n3. 把生成的 `lib/client.js` 拷回来，并把其中注册的 `id` 改成 `dsh-whale-diving`。\n\n`lib/client.js` 里的 `id` 与 CSS 去重键都已经被改成本包名，直接编辑源码时注意别把它们改回去。\n"
    },
    {
      "path": "src/client/index.ts",
      "encoding": "utf8",
      "content": "/**\n * Whale-diving surface plugin, browser half: the DeepSeek whale mark animated\n * as a breaching dive with a water spout, registered beside the chat flow's\n * running turn status (\"Deep diving...\"). Purely decorative — zero business\n * face, zero copy, zero store. Export discipline: packages/client/AGENTS.md.\n */\nimport type { ClientContext } from '@deepseek-ai/dsh-client-runtime/client'\n// Type-only: pulls ui-conversation's SlotMap merge (the\n// 'conversation.chat.turnStatusIcon' entry) so the registration type-checks.\nimport type {} from '@deepseek-ai/dsh-client-ui-conversation/client'\nimport { WhaleDivingLogo } from './WhaleDivingLogo.tsx'\n\n/** Required services (cordis fiber inject). */\nexport const inject = ['slots']\n\n/**\n * Client plugin body: register the looping whale animation into the turn-status\n * icon seat declared by ui-conversation. The seat renders nothing when no\n * occupant registers, so this plugin is additive and self-contained.\n * @param ctx - client root context.\n */\nexport function apply(ctx: ClientContext): void {\n  ctx.slots.inject('conversation.chat.turnStatusIcon', () => ctx.slots.register(\n    { name: 'conversation.chat.turnStatusIcon' },\n    WhaleDivingLogo,\n  ))\n}\n"
    },
    {
      "path": "src/client/WhaleDivingLogo.module.css",
      "encoding": "utf8",
      "content": "/* One 3.6s cycle aligns with two sweeps of the adjacent status copy. */\n\n.root {\n  position: relative;\n  flex: none;\n  width: 22px;\n  height: 22px;\n  margin-right: 6px;\n  color: var(--dsw-alias-state-business-primary);\n}\n\n.whale {\n  position: absolute;\n  left: 3px;\n  bottom: 4px;\n  display: flex;\n  animation: dsh-whale-path 3.6s linear infinite;\n  will-change: transform, opacity;\n  backface-visibility: hidden;\n  z-index: 2;\n}\n\n.whale > svg {\n  transform-box: fill-box;\n  transform-origin: 52% 72%;\n  animation: dsh-whale-pose 3.6s linear infinite;\n  will-change: transform;\n}\n\n.fx {\n  position: absolute;\n  inset: 0;\n  width: 22px;\n  height: 22px;\n  pointer-events: none;\n  z-index: 3;\n}\n\n.surface,\n.ripple,\n.spray,\n.splash {\n  fill: none;\n  stroke: currentColor;\n  stroke-linecap: round;\n}\n\n.surface {\n  stroke-width: 1.1;\n  opacity: 0.28;\n}\n\n.ripple,\n.spray,\n.splash {\n  stroke-dasharray: 1;\n  stroke-dashoffset: 1;\n}\n\n.ripple {\n  stroke-width: 0.9;\n  transform-box: fill-box;\n  transform-origin: center;\n  animation: dsh-whale-ripple 3.6s linear infinite;\n}\n\n.spray {\n  stroke-width: 1.05;\n  animation: dsh-whale-spray 3.6s linear infinite;\n}\n\n.splash {\n  stroke-width: 1;\n  animation: dsh-whale-splash 3.6s linear infinite;\n}\n\n@keyframes dsh-whale-path {\n  0%, 8% { transform: translate3d(0, 8px, 0); opacity: 0; }\n  16% { transform: translate3d(-0.5px, 4px, 0); opacity: 0.45; }\n  24% { transform: translate3d(-1px, 0, 0); opacity: 1; }\n  32% { transform: translate3d(-0.5px, -2px, 0); opacity: 1; }\n  40% { transform: translate3d(0, -3px, 0); opacity: 1; }\n  48% { transform: translate3d(0.5px, -2px, 0); opacity: 1; }\n  56% { transform: translate3d(1px, 0, 0); opacity: 1; }\n  64% { transform: translate3d(0.5px, 3px, 0); opacity: 0.9; }\n  72% { transform: translate3d(-0.5px, 8px, 0); opacity: 0; }\n  100% { transform: translate3d(0, 8px, 0); opacity: 0; }\n}\n\n@keyframes dsh-whale-pose {\n  0%, 16% { transform: rotate(0deg); }\n  32% { transform: rotate(9deg); }\n  40% { transform: rotate(8deg); }\n  48% { transform: rotate(3deg); }\n  56% { transform: rotate(-5deg); }\n  64% { transform: rotate(-18deg); }\n  72% { transform: rotate(-25deg); }\n  80%, 100% { transform: rotate(0deg); }\n}\n\n@keyframes dsh-whale-spray {\n  0%, 24% { stroke-dashoffset: 1; opacity: 0; }\n  31% { stroke-dashoffset: 0; opacity: 0.85; }\n  40% { stroke-dashoffset: 0; opacity: 0.7; }\n  48% { stroke-dashoffset: -1; opacity: 0; }\n  100% { stroke-dashoffset: 1; opacity: 0; }\n}\n\n@keyframes dsh-whale-splash {\n  0%, 57% { stroke-dashoffset: 1; opacity: 0; }\n  64% { stroke-dashoffset: 0; opacity: 0.75; }\n  72% { stroke-dashoffset: -1; opacity: 0; }\n  100% { stroke-dashoffset: 1; opacity: 0; }\n}\n\n@keyframes dsh-whale-ripple {\n  0%, 59% { stroke-dashoffset: 1; transform: scaleX(0.2); opacity: 0; }\n  65% { stroke-dashoffset: 0; transform: scaleX(0.38); opacity: 0.6; }\n  75% { stroke-dashoffset: 0; transform: scaleX(0.72); opacity: 0.45; }\n  88% { stroke-dashoffset: 0; transform: scaleX(1); opacity: 0; }\n  100% { stroke-dashoffset: 1; transform: scaleX(1); opacity: 0; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .whale,\n  .whale > svg,\n  .ripple {\n    animation: none;\n  }\n\n  .whale {\n    transform: translateY(-1px);\n    opacity: 1;\n  }\n\n  .ripple {\n    stroke-dashoffset: 0;\n    transform: scaleX(0.72);\n    opacity: 0.55;\n  }\n\n  .spray,\n  .splash {\n    display: none;\n  }\n}\n"
    },
    {
      "path": "src/client/WhaleDivingLogo.tsx",
      "encoding": "utf8",
      "content": "/** Whale-diving turn-status icon: the DeepSeek whale breaching with a spout. */\nimport { FishLogo } from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'\n// Type-only: resolves the 'conversation.chat.turnStatusIcon' SlotMap entry.\nimport type {} from '@deepseek-ai/dsh-client-ui-conversation/client'\nimport css from './WhaleDivingLogo.module.css'\n\nexport type WhaleDivingLogoProps = PropsRuntime<'conversation.chat.turnStatusIcon'>\n\n/**\n * Render a looping breach, spout, dive, and settling surface. Purely\n * decorative: the parent status row carries the accessible label.\n * @param _props - framework session kit (unused; the animation is self-contained).\n */\nexport function WhaleDivingLogo(_props: WhaleDivingLogoProps) {\n  return (\n    <span className={css.root} aria-hidden=\"true\">\n      <svg className={css.fx} viewBox=\"0 0 22 22\" fill=\"none\" aria-hidden=\"true\">\n        <path className={css.surface} d=\"M3 16.3 Q11 17.1 19 16.3\" />\n        <path className={css.ripple} pathLength=\"1\" d=\"M4 16.4 Q11 18.2 18 16.4\" />\n        <path className={css.spray} pathLength=\"1\" d=\"M9.8 5.2 C9.7 4.1 9.8 3.2 10.2 2.6\" />\n        <path className={css.spray} pathLength=\"1\" d=\"M10.2 2.6 C9.2 1.9 8.3 2 7.8 2.7\" />\n        <path className={css.spray} pathLength=\"1\" d=\"M10.2 2.6 C11.2 1.9 12.2 2 12.8 2.8\" />\n        <path className={css.splash} pathLength=\"1\" d=\"M10.7 16.2 C9.7 15 8.8 13.9 8.5 12.8\" />\n        <path className={css.splash} pathLength=\"1\" d=\"M11.2 16.2 C12.3 15 13.2 14.2 13.8 13.2\" />\n      </svg>\n      <span className={css.whale} data-whale-logo><FishLogo size={16} /></span>\n    </span>\n  )\n}\n"
    },
    {
      "path": "src/css-modules.d.ts",
      "encoding": "utf8",
      "content": "declare module '*.module.css' {\n  const classes: Readonly<Record<string, string>>\n  export default classes\n}\n"
    },
    {
      "path": "src/index.ts",
      "encoding": "utf8",
      "content": "/**\n * Whale-diving surface plugin, node half. The empty apply exists so the plugin\n * appears in the host cordis.yml / Loader; the browser half ships the running\n * turn-status icon through exports[\"./client\"], discovered from the package.json\n * dsh.client declaration.\n */\n\n/** Host plugin body — no host-side behavior for this surface plugin. */\nexport function apply(): void {}\n"
    }
  ]
}
