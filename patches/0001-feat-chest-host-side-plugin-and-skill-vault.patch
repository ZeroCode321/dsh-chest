+      if (encoded === null) return { code: 'io', message: `${entry.packageName} exceeds the chest bundle ceilings` }
+      return freezeBundle({
+        format: 'dsh-chest',
+        revision: 1,
+        kind: 'plugin',
+        id: entry.id,
+        name: entry.packageName,
