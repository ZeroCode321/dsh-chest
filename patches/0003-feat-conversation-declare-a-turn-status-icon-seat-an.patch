 packages/client/ui-conversation/src/client/apply.ts |  1 +
 .../ui-conversation/src/client/chat/ChatView.tsx    |  7 +++++--
 .../ui-conversation/src/client/contract/slots.ts    | 13 ++++++++++++-
 5 files changed, 30 insertions(+), 3 deletions(-)

